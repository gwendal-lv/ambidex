{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "bench",
            "hidden": true,
            "cacheVariables": {
                "AMBIDEX_BUILD_BENCH": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": ["base", "bench"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "release-scalar",
            "displayName": "Release, scalar FM kernels (benchmark baseline)",
            "inherits": "release",
            "cacheVariables": {
                "AMBIDEX_NEON": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "debug",
            "targets": ["Ambidex_Standalone"]
        },
        {
            "name": "release",
            "displayName": "Release",
            "configurePreset": "release",
            "targets": ["Ambidex_Standalone"]
        },
        {
            "name": "bench-release",
            "displayName": "Benchmark: Release",
            "configurePreset": "release",
            "targets": ["ambidex-bench"]
        },
        {
            "name": "bench-release-scalar",
            "displayName": "Benchmark: Release, scalar FM kernels",
            "configurePreset": "release-scalar",
            "targets": ["ambidex-bench"]
        }
    ]
}
